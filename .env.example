# PII Review — environment variables
# Copy this file to `.env` and adjust as needed. .env is gitignored.

# Flask server bind
PII_REVIEW_PORT=5000
FLASK_SERVER_HOST=localhost

# Optional: explicit path to the .env file if not located at project root.
# Useful for systemd/container deployments where the env lives elsewhere.
# PII_REVIEW_ENV_PATH=/etc/pii-review/.env

# Optional: poppler binary directory.
# Set this if `pdftotext` on your PATH is NOT the real poppler binary
# (most common: Windows + git-bash, where an xpdf-derived pdftotext wins
# the PATH lookup and silently produces zero words). Set to the directory
# containing the real poppler binaries, e.g.
#   POPPLER_BIN_DIR=C:\tools\poppler\poppler-24.08.0\Library\bin
# or on Linux/macOS this is normally unnecessary.
# POPPLER_BIN_DIR=

# Optional: verbose M-ROT-EVID per-occurrence debug logging in the
# tokenizer. Off by default — when enabled produces hundreds of lines per
# Apply. Entity values are NEVER logged regardless; only entity_len.
# PII_REVIEW_DEBUG_MROT=1
